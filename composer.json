{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "cosamey/spine",
    "description": "Pragmatic Laravel foundation package with sensible defaults and reusable conventions.",
    "keywords": ["laravel"],
    "license": "MIT",
    "authors": [
        {
            "name": "Chris Teyerl",
            "email": "chris.teyerl@cosamey.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "spatie/laravel-package-tools": "^1.93"
    },
    "require-dev": {
        "larastan/larastan": "^3.9.3",
        "laravel/pint": "^1.29.0",
        "orchestra/testbench": "^10.9",
        "pestphp/pest": "^4.4.2",
        "pestphp/pest-plugin-laravel": "^4.1"
    },
    "autoload": {
        "psr-4": {
            "Mey\\Spine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mey\\Spine\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "vendor/bin/testbench package:discover --ansi"
        ],
        "analyse": "phpstan analyse --ansi",
        "check": [
            "@analyse",
            "@format:check",
            "@test"
        ],
        "format": "pint",
        "format:check": "pint --test",
        "test": "pest --ci"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mey\\Spine\\SpineServiceProvider"
            ],
            "aliases": {
                "Spine": "Mey\\Spine\\Facades\\Spine"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
